{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://intertie.dev/schemas/0.1/discovery.schema.json",
  "title": "Intertie discovery document",
  "type": "object",
  "required": ["intertie", "org", "endpoint", "keys"],
  "properties": {
    "intertie": { "type": "string", "pattern": "^[0-9]+\\.[0-9]+$" },
    "org": { "type": "string", "minLength": 1, "maxLength": 253 },
    "display_name": { "type": "string", "maxLength": 80 },
    "endpoint": { "type": "string", "format": "uri", "pattern": "^https?://[^?#]+$" },
    "keys": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object",
        "required": ["kty", "crv", "kid", "x"],
        "properties": {
          "kty": { "const": "OKP" },
          "crv": { "const": "Ed25519" },
          "kid": { "type": "string", "pattern": "^[A-Za-z0-9._-]{1,64}$" },
          "x": { "type": "string", "pattern": "^[A-Za-z0-9_-]{43}$" }
        }
      }
    },
    "delivery": { "enum": ["push", "pull"] },
    "capabilities": { "type": "array", "items": { "type": "string", "minLength": 1, "maxLength": 128 }, "maxItems": 64 },
    "limits": {
      "type": "object",
      "properties": {
        "max_body_bytes": { "type": "integer", "minimum": 65536 },
        "max_file_bytes": { "type": "integer", "minimum": 0 }
      }
    },
    "contact": { "type": "string", "maxLength": 512 }
  }
}
