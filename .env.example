# Copy to .env.a / .env.b (or use scripts/setup-env.sh). Never commit real values.
SLACK_BOT_TOKEN=xoxb-...
SLACK_APP_TOKEN=xapp-...
# SLACK_SIGNING_SECRET=...   # only for Events API (HTTP) mode instead of Socket Mode
INTERTIE_PORT=8711
INTERTIE_DISPLAY_NAME=Workspace A
INTERTIE_STATE_DIR=./state/a
# Production (not dev mode):
# INTERTIE_ORG=connect.example.com
# INTERTIE_ENDPOINT=https://connect.example.com/intertie
# INTERTIE_CONTACT=mailto:security@example.com
